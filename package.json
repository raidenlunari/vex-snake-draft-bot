{
  "name": "vex-snake-draft-bot",
  "version": "1.0.0",
  "description": "Discord bot for running snake drafts of VEX Robotics teams at robotics events",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "register": "tsx src/discord/registerCommands.ts",
    "migrate": "tsx src/db/migrateCli.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "csv-parse": "^7.0.3",
    "discord.js": "^14.27.0",
    "dotenv": "^18.0.5",
    "luxon": "^3.7.2",
    "pino": "^10.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/luxon": "^3.7.6",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^3.2.7"
  }
}
