# Discord bot token from the Discord Developer Portal (Bot -> Reset Token). Keep this secret.
DISCORD_TOKEN=

# Application (client) ID from the Developer Portal (General Information -> Application ID).
DISCORD_CLIENT_ID=

# Optional. When set, slash commands are registered to this guild only (instant updates, good for
# development or a single-server deployment). Leave empty to register commands globally.
DISCORD_GUILD_ID=

# Register slash commands automatically every time the bot starts (true/false).
REGISTER_COMMANDS_ON_START=true

# Path to the SQLite database file. The directory is created if missing.
DATABASE_PATH=./data/draft.db

# pino log level: trace, debug, info, warn, error, fatal
LOG_LEVEL=info

# Pretty-print logs for local development (true/false). Production should keep JSON logs.
LOG_PRETTY=false

# Default IANA time zone used for new drafts' skip-timer active hours.
DEFAULT_TIMEZONE=America/New_York

# Optional: Google Sheets mirroring. Path to a service-account JSON key (or put the JSON
# itself in GOOGLE_SERVICE_ACCOUNT_JSON). Share each sheet with the service account's email
# as an editor, then link it with /draft sheet set. See docs/SETUP.md.
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_SERVICE_ACCOUNT_JSON=
# Wait this long after the last change before writing to the sheet (batches bursts).
SHEET_SYNC_DEBOUNCE_MS=1500
